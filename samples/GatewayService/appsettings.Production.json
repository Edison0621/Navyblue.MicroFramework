{
  "Security": {
    "RateLimit": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "RateLimitPolicies": {
      "auth": {
        "Key": "auth",
        "PermitLimit": 8,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "write": {
        "Key": "write",
        "PermitLimit": 20,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "read": {
        "Key": "read",
        "PermitLimit": 80,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    },
    "Blacklist": [],
    "RateLimitExemptPaths": [
      "/",
      "/health/live",
      "/health/ready"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
