{
  "Jwt": {
    "Issuer": "DaprFx.AuthService",
    "Audience": "DaprFx.Services",
    "SigningKey": "DaprFx.Dev.Secret.Key.ChangeMe"
  },
  "Security": {
    "RateLimit": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "RateLimitPolicies": {
      "auth": {
        "Key": "auth",
        "PermitLimit": 20,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "write": {
        "Key": "write",
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "read": {
        "Key": "read",
        "PermitLimit": 120,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    },
    "Blacklist": [],
    "RateLimitExemptPaths": [
      "/",
      "/health/live",
      "/health/ready"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
